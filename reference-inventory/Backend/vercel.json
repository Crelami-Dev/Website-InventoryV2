{
  "version": 2,
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/retry-emails",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
